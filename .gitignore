node_modules/
dist/
.DS_Store
*.local

# env / logs（防止密钥或本地日志误提交）
.env
.env.*
# 例外：模板要提交，里面只有空键名，不含真实密钥
!.env.example
*.log

# python / script 本地缓存
**/__pycache__/
scripts/.cache/
# 脚本按 cwd 解析路径时会在仓库根留下的缓存（fetch_olle_osm.py 的 OSM 原始数据）
.cache/

# vite 构建时生成的临时配置（异常退出会残留）
vite.config.ts.timestamp-*

# 本地助手工作区（记忆 / 技能），不随仓库分发
.workbuddy/

# 轨迹中间产物：fetch_olle_osm.py 导出的 GeoJSON，随时可重抓
# 真正进仓库的是 public/tracks.json
tracks/
